# Database
DATABASE_URL="postgresql://USER@localhost:5432/helpdesk"

# Auth (better-auth)
BETTER_AUTH_SECRET="generate-with: openssl rand -hex 32"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:5173,http://localhost:5174"

# Seed — initial admin account created by prisma/seed.ts
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_RANDOM_PASSWORD_MIN_16_CHARS"

# Seed — AI auto-resolution agent account created by prisma/seed-ai-agent.ts
AI_AGENT_EMAIL="ai-agent@example.com"
AI_AGENT_PASSWORD="REPLACE_WITH_STRONG_RANDOM_PASSWORD_MIN_16_CHARS"

# Groq — used for ticket classification, auto-resolve, summarize, and "Polish" reply (free tier at console.groq.com)
GROQ_API_KEY="REPLACE_WITH_GROQ_API_KEY"

# Resend API authentication
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"

# Signing secret for the inbound-email webhook (svix-id/svix-timestamp/svix-signature headers)
RESEND_WEBHOOK_SECRET="REPLACE_WITH_RESEND_WEBHOOK_SECRET"

# Sender used for outgoing reply emails to customers. The shared onboarding@resend.dev
# address can only send to your own account email — verify a domain at resend.com/domains
# and use an address on that domain to send to real customers.
RESEND_FROM_EMAIL="Ticket Support <onboarding@resend.dev>"

# Email address you used to sign up for Resend
TEST_RECIPIENT_EMAIL="REPLACE_WITH_YOUR_EMAIL_ADDRESS"

# Sentry — error monitoring. Leave blank to disable (e.g. local dev/test) — create a project at sentry.io to get a DSN
SENTRY_DSN="REPLACE_WITH_SENTRY_DSN"
# Sentry environment tag (e.g. development, staging, production) — used to filter issues in Sentry
SENTRY_ENVIRONMENT="development"