#!/bin/sh
# Blocks a push if lint, unit/component, API integration, or browser tests fail.

set -eu

cd "$(git rev-parse --show-toplevel)"

echo "Running lint..."
bun run lint

echo "Running unit and component tests..."
bun run test:unit

echo "Running API integration tests..."
bun run test:integration

echo "Running browser E2E tests..."
bun run test:e2e e2e/pages
