# Local development defaults. Deployed builds use public/config.js.
# API
VITE_SERVER_BASE_URL="http://localhost:3000"

# Sentry — error monitoring. Leave blank to disable (e.g. local dev/test) — create a project at sentry.io to get a DSN
VITE_SENTRY_DSN="REPLACE_WITH_SENTRY_DSN"
# Sentry environment tag (e.g. development, staging, production) — used to filter issues in Sentry
VITE_SENTRY_ENVIRONMENT="development"
