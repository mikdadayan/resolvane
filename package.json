{
  "name": "helpdesk",
  "private": true,
  "scripts": {
    "dev:server": "cd server && bun dev",
    "dev:client": "cd client && bun dev",
    "dev": "concurrently -k -n server,client \"bun run dev:server\" \"bun run dev:client\"",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.3",
    "svix": "^1.96.1"
  }
}
