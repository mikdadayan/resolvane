{
  "name": "resolvane",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev:server": "pnpm --filter @resolvane/core build && turbo run dev --filter=@resolvane/server --filter=@resolvane/core",
    "dev:client": "pnpm --filter @resolvane/core build && turbo run dev --filter=@resolvane/client --filter=@resolvane/core",
    "dev": "pnpm --filter @resolvane/core build && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "test:integration": "turbo run build --filter=@resolvane/server && playwright test e2e/api",
    "test:e2e": "turbo run build --filter=@resolvane/server && playwright test",
    "test:e2e:ui": "turbo run build --filter=@resolvane/server && playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.3",
    "svix": "^1.96.1",
    "turbo": "^2.11.10",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": ">=24.22.3 <25",
    "pnpm": "10.34.9"
  }
}
