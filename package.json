{
  "name": "resolvane",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["client", "server", "core"],
  "scripts": {
    "dev:server": "turbo run dev --filter=@resolvane/server",
    "dev:client": "turbo run dev --filter=@resolvane/client",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "test:integration": "bunx playwright test e2e/api",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "svix": "^1.96.1",
    "turbo": "^2.11.10"
  }
}
