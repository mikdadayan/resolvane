{
  "name": "resolvane",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev:server": "pnpm --filter @resolvane/core build && turbo run dev --filter=@resolvane/server --filter=@resolvane/core",
    "dev:client": "pnpm --filter @resolvane/core build && turbo run dev --filter=@resolvane/client --filter=@resolvane/core",
    "dev": "pnpm backend:up && pnpm dev:client",
    "dev:stop": "pnpm backend:down",
    "dev:logs": "pnpm backend:logs",
    "dev:local": "pnpm --filter @resolvane/core build && turbo run dev",
    "backend:up": "docker compose -f compose.yaml -f compose.dev.yaml up --build --detach --wait --renew-anon-volumes backend",
    "backend:prod": "docker compose up --build --detach --wait backend",
    "backend:down": "docker compose down",
    "backend:logs": "docker compose logs --follow backend",
    "backend:migrate": "docker compose run --build --rm --no-deps backend node node_modules/prisma/build/index.js migrate deploy",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "test:integration": "turbo run build --filter=@resolvane/server && playwright test e2e/api",
    "test:e2e": "turbo run build --filter=@resolvane/server && playwright test",
    "test:e2e:ui": "turbo run build --filter=@resolvane/server && playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.3",
    "svix": "^1.96.1",
    "turbo": "^2.11.10",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": ">=24.22.3 <25",
    "pnpm": "10.34.9"
  }
}
